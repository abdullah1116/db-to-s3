# MariaDB connection
DB_HOST=db.example.com
DB_PORT=3306
DB_USER=backup
DB_PASS=change-me
DB_NAME=mydb

# AWS S3
AWS_REGION=us-east-1
AWS_S3_BUCKET=my-backups
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=change-me

# Compression (1-22, higher = smaller but slower)
ZSTD_LEVEL=22

# Retention: keep all backups for RETENTION_DAILY_DAYS, then one per week
# anchored on WEEKLY_ANCHOR_DAY (0=Sunday ... 6=Saturday)
RETENTION_DAILY_DAYS=30
WEEKLY_ANCHOR_DAY=0

# SMTP alerting (used by backup-failure-notify@.service via notify.sh/msmtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=change-me
SMTP_FROM=alerts@example.com
ALERT_TO=ops@example.com
SMTP_SECURITY=starttls
